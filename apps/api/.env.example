# Local Spring properties; copy to .env, never commit .env.
# Start the API from apps/api so this file is found.
# Generate private keys once with ../../scripts/configure-local.ps1.
NEXA_ONBOARDING_ENABLED=true
NEXA_ONBOARDING_IDENTITY_KEY=
NEXA_ONBOARDING_IDENTITY_KEY_ID=local-v1
NEXA_JWT_SECRET=

# Set database credentials here OR run scripts/setup-db.ps1 in the same terminal.
# Use a separate schema if NEXA_APP belongs to another checkout with different migrations.
# BANKING_DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
# BANKING_DB_USERNAME=NEXA_BANK_APP
# BANKING_DB_SCHEMA=NEXA_BANK_APP
# BANKING_DB_PASSWORD=

# Configure an administrator explicitly; no shared/demo customer is created.
# NEXA_ADMIN_EMAIL=
# NEXA_ADMIN_PASSWORD=

# Optional local model: install Ollama and pull the model separately.
# Use false to run core banking/basic chat without Ollama.
# NEXA_AI_ENABLED=true
# NEXA_AI_BASE_URL=http://localhost:11434
# NEXA_AI_MODEL=qwen3.5:4b

# Execute newly confirmed Nexa scheduled payments while the API is running.
# NEXA_SCHEDULED_PAYMENTS_ENABLED=true

# Optional Cashfree Payouts sandbox credentials; copy actual values only into your ignored .env.
# Payment Gateway keys are not Payouts keys. Never set LIVE: this release supports sandbox only.
NEXA_PAYOUTS_MODE=DISABLED
NEXA_PAYOUTS_CLIENT_ID=
NEXA_PAYOUTS_CLIENT_SECRET=
NEXA_PAYOUTS_TIMEOUT_SECONDS=15
# Account encryption uses your existing onboarding key unless NEXA_PAYOUTS_ACCOUNT_KEY is set.
# Preserve the chosen 32-byte base64 key with database backups; do not rotate it on each startup.
